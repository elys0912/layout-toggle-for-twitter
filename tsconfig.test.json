{
  // test/ の型の検査。node が型を外してそのまま実行するので、型を消すだけで動く書き方に限る
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  // test から読む src は import をたどれば検査に入る。lib に DOM が無い環境で読めることを確かめるため、あえて列挙する
  "include": ["test", "src/page-rules.ts", "src/registry.ts"]
}
